{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "myprovider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Custom Model Gateway",
      "options": {
        "baseURL": "{env:MODEL_BASE_URL}",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "kr/claude-opus-5.5": {
          "name": "My Model"
        }
      }
    }
  },
  "model": "myprovider/YOUR_MODEL_ID",
  "snapshot": false
}