#  Elite Portal environment template. Copy to .env and fill in real values.
#  Never commit real secrets.

# Core
APP_ENV=production
SECRET_KEY=generate-a-long-random-value
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
LOG_LEVEL=INFO

# Session
SESSION_LIFETIME_SECONDS=28800
# Use "none" only when the frontend is served from a different site than the API (requires HTTPS)
SESSION_COOKIE_SAMESITE=Lax

# Frontend / CORS (comma-separated, exact origins)
FRONTEND_URL=https://your-frontend.example.com
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Institutional settings
INSTITUTION_NAME=Francis Xavier Engineering College
INSTITUTION_TIMEZONE=Asia/Kolkata
BATCH_NAME=Elite Batch 2025-2029
MAX_OPTIONAL_DOMAINS=2

# Admin provisioning (required in production for seed-all)
ADMIN_PASSWORD=

# Cloudflare R2 (S3-compatible). Required in production for durable uploads.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=elite-portal-files
UPLOAD_FOLDER=
MAX_UPLOAD_BYTES=26214400

# Email (password reset). Leave MAIL_SERVER empty to disable.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Rate limiting on auth endpoints (per process)
RATELIMIT_ENABLED=true

# Approved-student roster (Google Apps Script web app). Leave URL empty to disable.
ROSTER_APPS_SCRIPT_URL=
ROSTER_SHARED_SECRET=
ROSTER_CACHE_SECONDS=600
ROSTER_TIMEOUT_SECONDS=8

# Set to true to expose /api/docs in production
ENABLE_API_DOCS=false
